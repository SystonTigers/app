{
  // Public website: marketing pages, club sign-up and club dashboards.
  // Built with `npm run cf:build`, deployed with `npm run cf:deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boost-huddle",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Used by this app's own server routes (/api/admin/*, /api/auth/admin-login)
    "BACKEND_API_BASE": "https://app-production.team-platform-2025.workers.dev"
  }
}
