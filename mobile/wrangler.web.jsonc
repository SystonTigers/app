{
  // The installable web version of the app (no store needed).
  // Build: node scripts/build-web.mjs   Deploy: npx wrangler deploy -c wrangler.web.jsonc
  "name": "boost-huddle-app",
  "compatibility_date": "2025-07-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
