# Copy to .env (or set per build profile in eas.json). Only EXPO_PUBLIC_* values
# are bundled into the app, so never put secrets here.

# Backend API (defaults to the production worker if unset)
EXPO_PUBLIC_API_BASE=https://app-production.team-platform-2025.workers.dev
# For local testing against `wrangler dev` use your PC's LAN IP, e.g.
# EXPO_PUBLIC_API_BASE=http://192.168.1.50:8787

# Leave empty for the multi-club app (people choose their club on first launch).
# Set to a club's web address (e.g. syston-tigers) to lock a build to that club.
EXPO_PUBLIC_TENANT_ID=

# Crash reporting (optional). Leave empty to disable.
EXPO_PUBLIC_SENTRY_DSN=
