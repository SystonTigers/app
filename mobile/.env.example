# Syston Tigers Mobile App - Environment Configuration Example
# Copy this file to .env and fill in your actual values

# API Configuration
EXPO_PUBLIC_API_BASE=https://syston-postbus.team-platform-2025.workers.dev
EXPO_PUBLIC_TENANT_ID=syston-tigers

# Club Branding
EXPO_PUBLIC_CLUB_NAME=Syston Tigers U13 Boys
EXPO_PUBLIC_CLUB_SHORT_NAME=Syston Tigers

# Supabase (Get from https://supabase.com/dashboard > Settings > API)
EXPO_PUBLIC_SUPABASE_URL=your-project-url-here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# App Configuration
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_GEO_FENCE_RADIUS=500

# Feature Flags
EXPO_PUBLIC_ENABLE_OFFLINE=false
EXPO_PUBLIC_DEBUG_MODE=false

# HTTP Configuration
EXPO_PUBLIC_HTTP_TIMEOUT=30000
EXPO_PUBLIC_HTTP_RETRY=3

# Environment
NODE_ENV=development
