{
  "name": "team-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "web-app",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix web-app run dev",
    "test": "npm run test:backend && npm run test:web",
    "test:backend": "npm --prefix backend test",
    "test:web": "npm --prefix web-app run test",
    "prepare": "husky"
  }
}
