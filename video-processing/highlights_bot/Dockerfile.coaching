# Dockerfile for AI Coaching Service
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements_coaching.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements_coaching.txt

# Copy application code
COPY detect_mistakes.py .
COPY training_drills_ai.py .
COPY coaching_service.py .
COPY util.py .

# Expose port
EXPOSE 8000

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Run the service
CMD ["uvicorn", "coaching_service:app", "--host", "0.0.0.0", "--port", "8000"]
