{
  "name": "syston-backend",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --outdir=dist --out-extension:.js=.mjs --define:APP_VERSION=\\\"${npm_package_version}\\\" && esbuild src/queue-consumer.ts --bundle --format=esm --outdir=dist --out-extension:.js=.mjs --define:APP_VERSION=\\\"${npm_package_version}\\\"",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "d1:prep": "wrangler d1 execute DB --file ./src/schema/d1.sql",
    "seed:syston": "wrangler d1 execute DB --local --file=./scripts/seed-syston.sql",
    "seed:syston:remote": "wrangler d1 execute DB --remote --env production --file=./scripts/seed-syston.sql",
    "test": "vitest --run --config vitest.config.node.ts",
    "test:node": "vitest --run --config vitest.config.node.ts",
    "test:workers": "vitest --run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.node.ts",
    "test:coverage": "vitest --run --coverage --config vitest.config.node.ts",
    "lint": "eslint src --ext .ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.4.0",
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-istanbul": "^1.6.1",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "pretty-format": "^29.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vitest": "^1.6.1",
    "wrangler": "^3.15.0"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.0",
    "@team-platform/types": "file:../packages/types",
    "bcryptjs": "^2.4.3",
    "isomorphic-dompurify": "^2.31.0",
    "itty-router": "^4.0.23",
    "jose": "^6.1.0",
    "luxon": "^3.5.0",
    "node-fetch": "^3.3.2",
    "stripe": "^20.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}